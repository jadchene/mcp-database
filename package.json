{
  "name": "@jadchene/mcp-database-service",
  "version": "0.5.0",
  "description": "A multi-database MCP server with explicit persistent sessions, continuous SQL state, transaction tools, and guarded writes.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-database-service": "./dist/index.js"
  },
  "files": [
    "dist/config",
    "dist/core",
    "dist/db",
    "dist/server",
    "dist/utils",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/version.js",
    "dist/version.d.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "config/databases.example.json",
    "skills/database-mcp/SKILL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test \"dist/tests/*.test.js\"",
    "verify:reload": "node scripts/verify-config-reload.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "prebuild": "node scripts/clean-dist.mjs"
  },
  "keywords": [
    "mcp",
    "database",
    "mysql",
    "oracle",
    "postgresql",
    "redis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadchene/mcp-database.git"
  },
  "homepage": "https://github.com/jadchene/mcp-database#readme",
  "bugs": {
    "url": "https://github.com/jadchene/mcp-database/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "mysql2": "^3.23.2",
    "oracledb": "^6.10.0",
    "pg": "^8.23.0",
    "pg-cursor": "^2.15.3",
    "redis": "^5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
